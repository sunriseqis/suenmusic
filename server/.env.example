# ==============================================================================
# SuenMusic 服务端环境变量配置模板
# 复制本文件为 .env 即可生效：cp .env.example .env
# 所有非必要项均已有安全合理的默认值，除【必填项】外其余保持注释即可。
# ==============================================================================

# ---- 【强烈建议配置】认证密钥 ----
# JWT 签名密钥（至少 32 字符）。留空则每次启动随机生成 —— 重启后所有登录态失效：
#   Web 会话可自愈（刷新令牌在库里），但访问令牌与 6 小时流令牌会全废，
#   原生端被迫重新登录、正在播放的歌会因为流令牌失效而中断。
# 生成：openssl rand -hex 32
#
# ⚠️ 千万不要填示例/占位串。JWT 密钥是离线可验证的：占位密钥公开在仓库里，
#    等于任何人都能签出管理员令牌。服务端启动时会检查 —— 出现占位串或长度
#    不足会直接拒绝启动，而不是带病运行。
SUENMUSIC_JWT_SECRET=

# ---- 以下均为可选配置（默认已按推荐值生效，按需取消注释开启） ----

# ---- 网络与端口 ----
# 监听地址。默认只绑本机 127.0.0.1；要让手机客户端或局域网其他设备访问，请设为 0.0.0.0
# SUENMUSIC_HOST=0.0.0.0
# SUENMUSIC_PORT=3210

# 允许跨域来源（逗号分隔，默认 * 表示不限制）
# SUENMUSIC_CORS_ORIGINS=*

# 可信反向代理（决定是否采信 X-Forwarded-For 拿真实客户端 IP，登录节流依赖它）。
# 默认 false = 只信 TCP 对端地址。放在反代后面时填反代的来源地址，例如：
# SUENMUSIC_TRUST_PROXY=127.0.0.1,10.0.0.0/8
# ⚠️ 直连暴露在公网时不要写 true：那等于采信任何客户端伪造的 IP，登录节流失效。

# ---- 数据存储 ----
# SQLite 文件路径（相对 server/ 目录，默认 ./data/suenmusic.db）
# SUENMUSIC_DB=./data/suenmusic.db

# ---- 注册控制 ----
# 是否允许任意用户注册（默认 true。设为 false 时仅允许创建首个账号，后续建号走命令行）
# SUENMUSIC_ALLOW_REGISTRATION=true

# ---- 音源解析与匹配 ----
# 匹配熔断阈值（0-100，默认 60，低于该分数的候选音源拒绝播放）
# SUENMUSIC_MATCH_THRESHOLD=60
# 上游请求超时时间（毫秒，默认 10000）
# SUENMUSIC_UPSTREAM_TIMEOUT_MS=10000

# ---- 日志级别 ----
# debug | info | warn | error（默认 info）
# SUENMUSIC_LOG_LEVEL=info

# ---- 上游 Cookie（可选，推荐直接在 Web 设置页扫码绑定落库，优先级更高） ----
# SUENMUSIC_BILIBILI_COOKIE=
# SUENMUSIC_NETEASE_COOKIE=

# ---- 更新通道（GitHub 源；唯一来源）----
#
# 客户端不直连 GitHub（国内不稳、且鸿蒙/iOS 走系统浏览器发不出鉴权头），
# 由服务端定时去 GitHub Releases 拉最新构建、缓存到本地，客户端再从服务端下载。
#
# 来源只有两种：
#   github —— 开启（填了 GITHUB_REPO 就是它）
#   off    —— 关闭（缺省；REPO 留空即关闭）
#
# SUENMUSIC_UPDATE_SOURCE=github

# GitHub 仓库（owner/repo）。填了它 = 自动开启更新源；留空 = 关闭。
# SUENMUSIC_UPDATE_GITHUB_REPO=suenmusic/suenmusic

# ⚠️ 私有仓库必填：PAT（需要 repo 读权限）。没有它 Releases API 一律 404。
# 公开仓库则可选（仅用于提额）。
# SUENMUSIC_UPDATE_GITHUB_TOKEN=

# 可选：**GitHub API** 请求地址。默认 https://api.github.com；
# 国内访问不稳时指向自建反代（例：https://gh.example.com/api）。
# SUENMUSIC_UPDATE_GITHUB_API_BASE=

# 可选：**产物下载**代理前缀。默认直连 objects.githubusercontent.com；
# 填了它会在 browser_download_url 前拼接（例：https://gh-proxy.com/）。
# ⚠️ 不要与上面 API_BASE 混用：文件代理前缀套 JSON API 通常会失败。
# SUENMUSIC_UPDATE_GITHUB_PROXY=

# 产物缓存目录（务必放在持久化位置；docker 记得挂卷、fnOS 指到 @appdata）
# SUENMUSIC_UPDATE_CACHE_DIR=./data/updates

# 后台轮询间隔（分钟）。0 = 只在用户手点「检查更新」时才核对。
# SUENMUSIC_UPDATE_POLL_MINUTES=30

# ---- 产物命名约定（CI 侧照这个来，服务端按它认）----
#   Release tag : hw-v1.6.0          （其它平台 v1.6.0）
#   Asset 名    : SuenMusic-v1.6.0-release.hap   （.apk / .ipa 同理）

# ---- AI 推荐大模型（可选，建议直接在 Web 设置页配置并持久化） ----
# OpenAI 兼容接口配置
# SUENMUSIC_AI_BASE_URL=https://api.deepseek.com/v1
# SUENMUSIC_AI_KEY=sk-your-key-here
# SUENMUSIC_AI_MODEL=deepseek-chat
