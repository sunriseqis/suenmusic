# ==============================================================================
# SuenMusic 服务端环境变量配置模板
# 复制本文件为 .env 即可生效：cp .env.example .env
# 所有非必要项均已有安全合理的默认值，除【必填项】外其余保持注释即可。
# ==============================================================================

# ---- 【唯一必填】认证密钥 ----
# JWT 签名密钥。留空则每次启动随机生成，会导致服务重启后所有登录态失效！
# 生产环境必须显式配置一个长随机字符串（推荐使用 openssl rand -hex 32 生成）。
SUENMUSIC_JWT_SECRET=your_production_jwt_secret_change_me

# ---- 以下均为可选配置（默认已按推荐值生效，按需取消注释开启） ----

# ---- 网络与端口 ----
# 监听地址。默认只绑本机 127.0.0.1；要让手机客户端或局域网其他设备访问，请设为 0.0.0.0
# SUENMUSIC_HOST=0.0.0.0
# SUENMUSIC_PORT=3210

# 允许跨域来源（逗号分隔，默认 * 表示不限制）
# SUENMUSIC_CORS_ORIGINS=*

# ---- 数据存储 ----
# SQLite 文件路径（相对 server/ 目录，默认 ./data/suenmusic.db）
# SUENMUSIC_DB=./data/suenmusic.db

# ---- 注册控制 ----
# 是否允许任意用户注册（默认 true。设为 false 时仅允许创建首个账号，后续建号走命令行）
# SUENMUSIC_ALLOW_REGISTRATION=true

# ---- 音源解析与匹配 ----
# 匹配熔断阈值（0-100，默认 60，低于该分数的候选音源拒绝播放）
# SUENMUSIC_MATCH_THRESHOLD=60
# 上游请求超时时间（毫秒，默认 10000）
# SUENMUSIC_UPSTREAM_TIMEOUT_MS=10000

# ---- 日志级别 ----
# debug | info | warn | error（默认 info）
# SUENMUSIC_LOG_LEVEL=info

# ---- 上游 Cookie（可选，推荐直接在 Web 设置页扫码绑定落库，优先级更高） ----
# SUENMUSIC_BILIBILI_COOKIE=
# SUENMUSIC_NETEASE_COOKIE=

# ---- Android 更新（可选；使用现有 UGREENlink 分享目录，不依赖 GitHub） ----
# 分享 ID，例如 87870bfaf0cf4e078326b43c063afa1e
# SUENMUSIC_UPDATE_SHARE_ID=87870bfaf0cf4e078326b43c063afa1e
# APK 所在分享目录
# SUENMUSIC_UPDATE_SHARE_PATH=/home/suenqi/应用/SuenApp/SuenMusic
# 可选：当前发布 APK 的 versionCode；文件名只能提供 versionName
# SUENMUSIC_UPDATE_VERSION_CODE=10001
# 可选：APK SHA-256（64 位十六进制）
# SUENMUSIC_UPDATE_SHA256=
# UGREEN API 基地址（默认无需修改）
# SUENMUSIC_UPDATE_UGREEN_BASE_URL=https://suenqi.cn35.ug.link/ugreen/v1

# ---- AI 推荐大模型（可选，建议直接在 Web 设置页配置并持久化） ----
# OpenAI 兼容接口配置
# SUENMUSIC_AI_BASE_URL=https://api.deepseek.com/v1
# SUENMUSIC_AI_KEY=sk-your-key-here
# SUENMUSIC_AI_MODEL=deepseek-chat
