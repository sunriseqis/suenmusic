<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>SuenMusic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- 后台/锁屏播放：这是原生化最直接的收益，必须有 -->
	<!-- Live Activity / 灵动岛：缺这个 key 时 ActivityKit 直接拒绝请求（Target does not include NSSupportsLiveActivities）-->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<!-- 灵动岛/锁屏卡点击后的落地页：suenmusic://player（见 SuenWidgets/PlaybackLiveActivity.swift 的 widgetURL） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.suenmusic.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>suenmusic</string>
			</array>
		</dict>
	</array>

	<!-- 更新通道（旧仓 §九-6）：不登记这两个 scheme，canOpenURL 恒 false，
	     更新会被静默降级成「用 Safari 打开」，用户拿不到重签工具的直接安装入口 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>altstore</string>
		<string>sidestore</string>
	</array>

	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 自托管现实：服务端常是局域网 http（无证书），因此放行明文；公网请务必用 https -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- iOS 14+ 访问局域网需用户授权 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问局域网内的 SuenMusic 服务端以播放音乐。</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
