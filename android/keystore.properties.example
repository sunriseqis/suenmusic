# 签名凭据模板 —— 复制为 android/keystore.properties 后填写真实值。
#
#   cp android/keystore.properties.example android/keystore.properties
#
# android/keystore.properties 已在 .gitignore 里，**绝不要提交**。
# 路径相对 android/（Gradle rootProject），例如：
#   storeFile=app/suenmusic.keystore
#
# CI 也可以完全不用这个文件，改用环境变量：
#   SUENMUSIC_KEYSTORE_FILE / SUENMUSIC_KEYSTORE_PASSWORD
#   SUENMUSIC_KEYSTORE_ALIAS / SUENMUSIC_KEYSTORE_KEY_PASSWORD

storeFile=app/suenmusic.keystore
storePassword=
keyAlias=
keyPassword=
