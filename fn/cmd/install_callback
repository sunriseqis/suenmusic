#!/bin/bash

### This script is called after the user installs the application.

# Ensure application files and data directory exist with full permissions
if [ -n "${TRIM_APPDEST}" ] && [ -d "${TRIM_APPDEST}" ]; then
    chmod -R 755 "${TRIM_APPDEST}" 2>/dev/null || true
fi

if [ -n "${TRIM_PKGVAR}" ]; then
    mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null || true
    chmod -R 777 "${TRIM_PKGVAR}" 2>/dev/null || true
fi

exit 0