#!/bin/bash
#
# 安装后回调。
# 飞牛 fnOS 在套件解压和文件布局完成后调用本脚本。
# 此时 wizard/install 收集到的向导变量已作为环境变量注入：
#   wizard_port: 用户设置的服务端口（默认 3210）
#   wizard_admin_user: 初始管理员用户名（默认 admin）
#   wizard_admin_password: 初始管理员密码
#   wizard_admin_display_name: 管理员显示昵称（默认 管理员）

set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${TRIM_APPDEST:-}"
VAR_DIR="${TRIM_PKGVAR:-}"
ETC_DIR="${TRIM_PKGETC:-}"

if [ -z "${APP_DIR}" ]; then
    APP_DIR="$(cd "${SCRIPT_DIR}/.." 2>/dev/null && pwd)"
fi
if [ -z "${VAR_DIR}" ]; then
    PKG_ROOT="$(cd "${APP_DIR}/.." 2>/dev/null && pwd)"
    VAR_DIR="${PKG_ROOT}/var"
fi
if [ -z "${ETC_DIR}" ]; then
    PKG_ROOT_ETC="$(cd "${APP_DIR}/.." 2>/dev/null && pwd)"
    ETC_DIR="${PKG_ROOT_ETC}/etc"
fi

case "${VAR_DIR}" in
    ""|"/"|"/var"|"/usr"|"/tmp") LOG_FILE=/dev/null ;;
    *) LOG_FILE="${VAR_DIR}/info.log" ;;
esac

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_callback] $1" >> "${LOG_FILE}" 2>/dev/null
}

log_msg "开始执行安装后初始化..."

# 1. 全局同步端口配置至 etc/.env、桌面 ui/config 及 manifest 元数据
PORT="${wizard_port:-${SUENMUSIC_PORT:-3210}}"
mkdir -p "${ETC_DIR}" 2>/dev/null || true
ENV_FILE="${ETC_DIR}/.env"

if [ -n "${PORT}" ]; then
    touch "${ENV_FILE}" 2>/dev/null || true
    if grep -q "^SUENMUSIC_PORT=" "${ENV_FILE}" 2>/dev/null; then
        sed -i "s/^SUENMUSIC_PORT=.*/SUENMUSIC_PORT=${PORT}/" "${ENV_FILE}" 2>/dev/null || true
    else
        echo "SUENMUSIC_PORT=${PORT}" >> "${ENV_FILE}" 2>/dev/null || true
    fi
    log_msg "已写入自定义端口配置 SUENMUSIC_PORT=${PORT} -> ${ENV_FILE}"

    # 递归/多路径同步所有存在的 ui/config（保证桌面快捷方式读取到新端口）
    POSSIBLE_UI_CONFIGS=(
        "${APP_DIR}/ui/config"
        "${APP_DIR}/app/ui/config"
        "${PKG_ROOT}/ui/config"
        "${PKG_ROOT}/target/ui/config"
        "${SCRIPT_DIR}/../ui/config"
        "${SCRIPT_DIR}/../target/ui/config"
        "/var/apps/suenmusic/ui/config"
        "/var/apps/suenmusic/target/ui/config"
        "/var/packages/suenmusic/target/ui/config"
        "/var/packages/suenmusic/ui/config"
    )
    for conf in "${POSSIBLE_UI_CONFIGS[@]}"; do
        if [ -f "${conf}" ]; then
            sed -i "s/\"port\":[[:space:]]*\"[0-9]*\"/\"port\": \"${PORT}\"/" "${conf}" 2>/dev/null || true
            log_msg "已同步桌面入口端口 (${PORT}) -> ${conf}"
        fi
    done

    # 同步系统 manifest / INFO 元数据（系统服务中心与桌面快捷方式注册数据源）
    POSSIBLE_MANIFESTS=(
        "${APP_DIR}/manifest"
        "${APP_DIR}/../manifest"
        "${PKG_ROOT}/manifest"
        "${SCRIPT_DIR}/../manifest"
        "/var/apps/suenmusic/manifest"
        "/var/packages/suenmusic/manifest"
        "/var/packages/suenmusic/INFO"
    )
    for mf in "${POSSIBLE_MANIFESTS[@]}"; do
        if [ -f "${mf}" ]; then
            sed -i "s/^service_port[[:space:]]*=.*/service_port = ${PORT}/" "${mf}" 2>/dev/null || true
            log_msg "已同步系统元数据 service_port (${PORT}) -> ${mf}"
        fi
    done
fi

# 2. 创建初始管理员账号
DATA_DIR="${VAR_DIR}/data"
mkdir -p "${DATA_DIR}" 2>/dev/null || true

NODE_BIN=""
if [ -x "${APP_DIR}/bin/node" ]; then
    NODE_BIN="${APP_DIR}/bin/node"
elif command -v node >/dev/null 2>&1; then
    NODE_BIN="$(command -v node)"
fi

ADMIN_USER="${wizard_admin_user:-admin}"
ADMIN_PASS="${wizard_admin_password:-}"
ADMIN_NAME="${wizard_admin_display_name:-管理员}"

if [ -n "${ADMIN_PASS}" ]; then
    if [ "${#ADMIN_PASS}" -lt 8 ]; then
        log_msg "[ERROR] 密码长度小于 8 位（当前 ${#ADMIN_PASS} 位），服务端密码策略拒绝弱密码，未能创建账号！"
    elif [ -n "${NODE_BIN}" ] && [ -d "${APP_DIR}/server" ]; then
        log_msg "正在创建初始管理员账号: ${ADMIN_USER}..."
        export SUENMUSIC_DB="${DATA_DIR}/suenmusic.db"
        (
            cd "${APP_DIR}/server" || exit 0
            "${NODE_BIN}" --experimental-strip-types --disable-warning=ExperimentalWarning \
                src/scripts/user-add.ts -u "${ADMIN_USER}" -p "${ADMIN_PASS}" -n "${ADMIN_NAME}" >> "${LOG_FILE}" 2>&1
        )
        RC=$?
        if [ "${RC}" = "0" ]; then
            log_msg "初始管理员账号 [${ADMIN_USER}] 创建成功，开箱即用"
        else
            log_msg "[WARN] 管理员账号创建脚本返回 ${RC}，请查看日志详情"
        fi
    else
        log_msg "[WARN] Node 运行时或服务端目录不存在，跳过创建管理员账号"
    fi
else
    log_msg "未提供初始管理员密码，跳过创建管理员账号"
fi

log_msg "安装后初始化完成"
exit 0
