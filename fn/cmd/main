#!/bin/bash

APP_DIR="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
LOG_FILE="${VAR_DIR}/info.log"
PID_FILE="${VAR_DIR}/app.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

find_node() {
    if [ -x "${APP_DIR}/bin/node" ]; then
        echo "${APP_DIR}/bin/node"
    elif command -v node >/dev/null 2>&1; then
        command -v node
    else
        echo ""
    fi
}

start_process() {
    if status; then
        log_msg "SuenMusic is already running"
        return 0
    fi

    log_msg "Starting SuenMusic native server..."
    mkdir -p "${VAR_DIR}/data"

    NODE_BIN=$(find_node)
    if [ -z "${NODE_BIN}" ]; then
        log_msg "[ERROR] Node.js binary not found! Neither bundled nor system node available."
        return 1
    fi

    log_msg "Using Node binary: ${NODE_BIN}"

    export NODE_ENV="production"
    export SUENMUSIC_HOST="0.0.0.0"
    export SUENMUSIC_PORT="3210"
    export SUENMUSIC_DB="${VAR_DIR}/data/suenmusic.db"
    export SUENMUSIC_DATA_DIR="${VAR_DIR}/data"
    export SUENMUSIC_WEB_ROOT="${APP_DIR}/web/dist"
    export TZ="Asia/Shanghai"

    cd "${APP_DIR}/server" || exit 1

    nohup "${NODE_BIN}" --disable-warning=ExperimentalWarning src/index.ts >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!

    printf "%s" "$new_pid" > "${PID_FILE}"
    log_msg "SuenMusic started with PID: ${new_pid}"

    sleep 1
    if check_process "$new_pid"; then
        log_msg "Process is alive and listening."
        return 0
    else
        log_msg "Process failed to stay alive! Check logs above."
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "Stopping SuenMusic native server..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "Process not found; cleaned stale PID file."
            return 0
        fi

        log_msg "Sending TERM signal to PID ${pid}..."
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "Waiting process to terminate... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "Force killing PID ${pid}..."
            kill -KILL "${pid}" 2>/dev/null
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "Process terminated gracefully."
            rm -f "${PID_FILE}"
        fi
    fi

    return 0
}

case $1 in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit $?
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
