#!/bin/bash
#
# 升级后回调：拉起新版本，并**确认它真的在响应**。
#
# 以前这个脚本是裸的 `exit 0`，于是"升级完成但服务没起来"完全没人知道 ——
# 应用中心显示正常，用户打开客户端却连不上（而 checkport 只探测端口，
# 端口是上游守护进程可能已经开了、服务却还没初始化完）。
#
# 这里除了 start，还会打一次 /api/health 并记下返回的 version，
# 版本号会写进 info.log，事后排查"到底跑的是不是新版"不用再猜。

# 数据目录解析（与 cmd/main 同一套反推 + 硬闸）：TRIM_PKGVAR 为空时
# 直接把日志写到 /info.log 会污染根分区（用户实测踩过），这里退到 /dev/null。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAR_DIR="${TRIM_PKGVAR:-}"
if [ -z "${VAR_DIR}" ]; then
    PKG_ROOT="$(cd "${SCRIPT_DIR}/../.." 2>/dev/null && pwd)"
    VAR_DIR="${PKG_ROOT}/var"
fi
case "${VAR_DIR}" in
    ""|"/"|"/var"|"/usr"|"/tmp") LOG_FILE=/dev/null ;;
    *) LOG_FILE="${VAR_DIR}/info.log" ;;
esac
PORT="${SUENMUSIC_PORT:-3210}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [upgrade_callback] $1" >> "${LOG_FILE}" 2>/dev/null
}

log_msg "升级完成，启动新版本"
"${SCRIPT_DIR}/main" start >> "${LOG_FILE}" 2>&1
START_RC=$?
log_msg "main start 返回 ${START_RC}"

# 服务初始化（建库/迁移/上游探测）需要时间，最多等 30 秒
HEALTH=""
for _ in $(seq 1 30); do
    if command -v curl >/dev/null 2>&1; then
        HEALTH="$(curl -fsS --max-time 3 "http://127.0.0.1:${PORT}/api/health" 2>/dev/null)"
    else
        HEALTH="$(node -e "
            const http=require('http');
            http.get({host:'127.0.0.1',port:${PORT},path:'/api/health',timeout:3000},r=>{
                let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d)});
            }).on('error',()=>{});
            setTimeout(()=>process.exit(0),3500);
        " 2>/dev/null)"
    fi
    [ -n "${HEALTH}" ] && break
    sleep 1
done

if [ -n "${HEALTH}" ]; then
    log_msg "健康检查通过：${HEALTH}"
else
    log_msg "[WARN] 健康检查失败：30 秒内 /api/health 无响应，请查看 ${LOG_FILE} 与服务端日志"
fi

# 回调里返回非零会让应用中心把升级标记为失败 —— 服务已起来就不该判失败
exit 0
