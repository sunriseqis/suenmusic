#!/bin/bash
#
# 设置页的配置变更回调。
#
# fnOS 在用户在应用设置页改完环境变量或 wizard/config 后调用它。
# 此时 wizard/config 收集到的向导变量（如 wizard_port）会作为环境变量注入。
#
# 这里做三件事：
#   1. 若传入了 wizard_port，持久化到 etc/.env 并同步 app/ui/config；
#   2. 重启服务以按新配置运行（stop + start）；
#   3. 把结果写进 info.log，事后能查"这次改动到底有没有生效"。

set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${TRIM_APPDEST:-}"
VAR_DIR="${TRIM_PKGVAR:-}"
ETC_DIR="${TRIM_PKGETC:-}"

if [ -z "${APP_DIR}" ]; then
    APP_DIR="$(cd "${SCRIPT_DIR}/.." 2>/dev/null && pwd)"
fi
if [ -z "${VAR_DIR}" ]; then
    PKG_ROOT="$(cd "${APP_DIR}/.." 2>/dev/null && pwd)"
    VAR_DIR="${PKG_ROOT}/var"
fi
if [ -z "${ETC_DIR}" ]; then
    PKG_ROOT_ETC="$(cd "${APP_DIR}/.." 2>/dev/null && pwd)"
    ETC_DIR="${PKG_ROOT_ETC}/etc"
fi

case "${VAR_DIR}" in
    ""|"/"|"/var"|"/usr"|"/tmp") LOG_FILE=/dev/null ;;
    *) LOG_FILE="${VAR_DIR}/info.log" ;;
esac

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [config_callback] $1" >> "${LOG_FILE}" 2>/dev/null
}

log_msg "配置变更回调开始执行..."

# 1. 若向导或环境传入了新端口，全局同步 etc/.env、桌面 ui/config 及 manifest 元数据
NEW_PORT="${wizard_port:-${SUENMUSIC_PORT:-}}"
if [ -n "${NEW_PORT}" ]; then
    mkdir -p "${ETC_DIR}" 2>/dev/null || true
    ENV_FILE="${ETC_DIR}/.env"
    touch "${ENV_FILE}" 2>/dev/null || true
    if grep -q "^SUENMUSIC_PORT=" "${ENV_FILE}" 2>/dev/null; then
        sed -i "s/^SUENMUSIC_PORT=.*/SUENMUSIC_PORT=${NEW_PORT}/" "${ENV_FILE}" 2>/dev/null || true
    else
        echo "SUENMUSIC_PORT=${NEW_PORT}" >> "${ENV_FILE}" 2>/dev/null || true
    fi
    log_msg "已更新端口配置 SUENMUSIC_PORT=${NEW_PORT} -> ${ENV_FILE}"

    # 递归/多路径同步所有存在的 ui/config（保证桌面快捷方式读取到新端口）
    POSSIBLE_UI_CONFIGS=(
        "${APP_DIR}/ui/config"
        "${APP_DIR}/app/ui/config"
        "${PKG_ROOT}/ui/config"
        "${PKG_ROOT}/target/ui/config"
        "${SCRIPT_DIR}/../ui/config"
        "${SCRIPT_DIR}/../target/ui/config"
        "/var/apps/suenmusic/ui/config"
        "/var/apps/suenmusic/target/ui/config"
        "/var/packages/suenmusic/target/ui/config"
        "/var/packages/suenmusic/ui/config"
    )
    for conf in "${POSSIBLE_UI_CONFIGS[@]}"; do
        if [ -f "${conf}" ]; then
            sed -i -E "s/\"port\":[[:space:]]*\"[^\"]*\"/\"port\": \"${NEW_PORT}\"/" "${conf}" 2>/dev/null || true
            log_msg "已同步桌面入口端口 (${NEW_PORT}) -> ${conf}"
        fi
    done

    # 同步系统 manifest / INFO 元数据（系统服务中心与桌面快捷方式注册数据源）
    POSSIBLE_MANIFESTS=(
        "${APP_DIR}/manifest"
        "${APP_DIR}/../manifest"
        "${PKG_ROOT}/manifest"
        "${SCRIPT_DIR}/../manifest"
        "/var/apps/suenmusic/manifest"
        "/var/packages/suenmusic/manifest"
        "/var/packages/suenmusic/INFO"
    )
    for mf in "${POSSIBLE_MANIFESTS[@]}"; do
        if [ -f "${mf}" ]; then
            sed -i "s/^service_port[[:space:]]*=.*/service_port = ${NEW_PORT}/" "${mf}" 2>/dev/null || true
            log_msg "已同步系统元数据 service_port (${NEW_PORT}) -> ${mf}"
        fi
    done
fi

# 2. 重启服务
log_msg "正在重启服务以使新配置生效..."
"${SCRIPT_DIR}/main" stop >> "${LOG_FILE}" 2>&1
"${SCRIPT_DIR}/main" start >> "${LOG_FILE}" 2>&1
RC=$?
if [ "${RC}" = "0" ]; then
    log_msg "已按新配置成功重启"
else
    log_msg "[WARN] 重启失败（rc=${RC}），请查看 ${LOG_FILE}"
fi

# 不返回非零：配置回调失败会被应用中心显示成"设置保存失败"，而服务其实可能正常
exit 0
