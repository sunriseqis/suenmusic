{
  "name": "suenmusic",
  "private": true,
  "version": "2.1.2",
  "description": "SuenMusic 单仓：服务端 + Web 面板/PC 客户端 + iOS/鸿蒙原生客户端 + fnOS 套件",
  "scripts": {
    "ios:sync": "node scripts/build-ios.mjs --sync-only",
    "ios:build": "node scripts/build-ios.mjs",
    "ios:unsigned": "node scripts/build-ios.mjs --unsigned",
    "hw:check": "node scripts/check-arkts.mjs",
    "hw:check:strict": "node scripts/check-arkts.mjs --strict",
    "hw:build": "node scripts/build-hw.mjs",
    "hw:sync": "node scripts/sync-hw.mjs",
    "web:build": "npm --prefix web run build",
    "fn:build": "node scripts/build-fn.mjs",
    "icons": "python3 scripts/gen-brand-icons.py",
    "wordmark": "python3 web/scripts/write-wordmark-assets.py"
  },
  "engines": {
    "node": ">=22"
  }
}
