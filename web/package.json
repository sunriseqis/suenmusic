{
  "name": "suenmusic-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuenMusic Web 客户端 —— 后端验证工具 + 安卓端设计探针",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "node --disable-warning=ExperimentalWarning scripts/lyric-test.ts",
    "gen:fonts": "node scripts/gen-fonts-css.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1"
  }
}
